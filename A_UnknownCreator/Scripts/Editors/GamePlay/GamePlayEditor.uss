.EditorRoot {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-self: stretch;
    justify-content: flex-start;
}

.OptionButton {
    min-height: auto;
    height: 30px;
    align-self: center;
}

.BaseText {
    -unity-font-definition: url("project://database/Assets/A_UnknownCreator/Fonts/MiSans/otf/MiSans-Normal%20SDF.asset?fileID=11400000&guid=4827b424dbef6224d81e67b97210d6b7&type=2#MiSans-Normal SDF");
    -unity-font-style: bold;
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
}

.Title {
    flex-shrink: 0;
    font-size: 18px;
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
    border-top-color: rgba(0, 0, 0, 0.2);
    border-bottom-color: rgba(0, 0, 0, 0.2);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    background-color: rgba(0, 0, 0, 0.08);
    margin-top: 10px;
    margin-right: 5px;
    margin-bottom: 10px;
    margin-left: 5px;
    -unity-font-definition: url("project://database/Assets/A_UnknownCreator/Fonts/MiSans/otf/MiSans-Normal%20SDF.asset?fileID=11400000&guid=4827b424dbef6224d81e67b97210d6b7&type=2#MiSans-Normal SDF");
}

.Panel {
    flex-shrink: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
    border-top-color: rgba(0, 0, 0, 0.2);
    border-bottom-color: rgba(0, 0, 0, 0.2);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    flex-direction: row;
}

.Workspace {
    height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    flex-direction: row;
    overflow: hidden;
}

.WorkspaceList {
    flex-shrink: 1;
    min-height: 0;
}

.InspectorViewport {
    flex-shrink: 1;
    min-height: 0;
}
